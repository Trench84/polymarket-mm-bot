POLY_DRY_RUN=true
POLY_PRIVATE_KEY=
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=
POLY_FUNDER_ADDRESS=
# Redemption needs a direct Polygon RPC (not part of Polymarket's REST API).
# The default is a public endpoint; consider a dedicated provider
# (Alchemy/Infura/QuickNode) for reliability once running live.
POLY_POLYGON_RPC_URL=https://polygon-rpc.com
POLY_CAPITAL_PER_WINDOW_USD=100
POLY_MAX_CONCURRENT_WINDOWS=1
POLY_N_LADDER_LEVELS=4
POLY_IMBALANCE_CEILING_SHARES=200
POLY_PULL_QUOTE_SECONDS=8
POLY_REDEMPTION_MAX_ATTEMPTS=5
